VITE_API_BASE_URL=http://localhost:3002/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:3002/api

# API extras: version segment appended by clients, and request timeout in ms.
VITE_API_VERSION=v1
VITE_API_TIMEOUT_MS=15000

# Google sign-in: the same OAuth client ID as the backend GOOGLE_CLIENT_ID.
# Authorised redirect URI in Google Cloud: <app origin>/google-callback
VITE_GOOGLE_CLIENT_ID=
