# Frontend (Vite) — only VITE_* variables are exposed to browser code.
# Local backend started by `npm run dev`; swap for the hosted API by setting
# VITE_API_BASE_URL=https://testapi.vemtap.com/api/v1
VITE_API_BASE_URL=http://localhost:3002/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:3002/api

# API extras: version segment appended by clients, and request timeout in ms.
VITE_API_VERSION=v1
VITE_API_TIMEOUT_MS=15000

# Google sign-in: the same OAuth client ID as the backend GOOGLE_CLIENT_ID.
# Authorised redirect URI in Google Cloud: <app origin>/google-callback
VITE_GOOGLE_CLIENT_ID=

# Public browser-safe integration keys (NEXT_PUBLIC_* in the old Next.js config).
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_VAPID_PUBLIC_KEY=
VITE_QR_THRIVE_URL=

# Server-side keys belong in backend/.env (see backend/.env for the full list):
# GOOGLE_CLIENT_ID, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET,
# GEMINI_API_KEY, VAPID_PUBLIC_KEY, PAYSTACK_SECRET_KEY, etc.
